# Used by docker-compose.yml. Copy to .env and fill in.
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Must be a valid address; reserved domains such as .local or .test are rejected at login.
ADMIN_EMAIL=admin@rentify.example.com
ADMIN_PASSWORD=
# true = load the demo catalog, customers and bookings on start (safe to leave on: it never duplicates).
SEED_DEMO_DATA=true

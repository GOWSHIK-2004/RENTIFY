# Matches the credentials in ../docker-compose.yml (development only).
DATABASE_URL=postgresql+psycopg://rentify:rentify_dev_password@localhost:5432/rentify
# Used by pytest only. Must point at a database whose name ends in "_test".
TEST_DATABASE_URL=postgresql+psycopg://rentify:rentify_dev_password@localhost:5432/rentify_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_ORIGIN=http://localhost:5173
